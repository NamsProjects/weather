# Kalshi API credentials for live WebSocket feed
# Get from: https://kalshi.com/account/api
#
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

KALSHI_KEY_ID=your-key-id-uuid-here

# Option A: path to your PEM file (recommended)
KALSHI_KEY_FILE=kalshi_key.pem

# Option B: paste PEM inline (use \n for newlines)
# KALSHI_KEY_PEM=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----

# wethr.net API key — from wethr.net
WETHR_API_KEY=your-wethr-api-key-here
